@article{massmodelsreview,
   author = "de Gouvea, Andre",
   title = "{Neutrino Mass Models}", 
   journal= "{Ann. Rev. Nucl. Part. Sci.}",
   year = "2016",
   volume = "66",
   number = "Volume 66, 2016",
   pages = "197-217",
   doi = "https://doi.org/10.1146/annurev-nucl-102115-044600",
